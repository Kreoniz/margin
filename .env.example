# Use a long URL-safe value (letters, numbers, hyphens) for the database password.
POSTGRES_PASSWORD=change-this-database-password
APP_PORT=8787
BIND_ADDRESS=127.0.0.1
# Keep at or below your host's outbound interface MTU (including VPN tunnels).
DOCKER_MTU=1376
# Optional owner password (12+ characters). Leave empty to set it in the browser.
APP_PASSWORD=
